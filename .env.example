# ==============================================================================
# Production E-Commerce Platform — Environment Variables Template
# Copy this file to .env.local for local development
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database (PostgreSQL 16+)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce_prod?schema=public"

# Redis (Caching, Rate Limiting & Queue)
REDIS_URL="redis://localhost:6379"

# Session & Security
# Generate 64-char random string: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-64-character-random-key-in-production-min-32-chars"
PASSWORD_SALT_ROUNDS=12

# Payment Provider Configuration
# Supported: "mock" | "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_example

# Storage / Media Assets
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./public/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Email / Notifications (Transactional)
# Supported: "mock" | "smtp" | "resend"
NOTIFICATION_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="orders@ecommercestore.com"

# Store Configuration Defaults
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US
DEFAULT_SAFETY_STOCK=0
INVENTORY_RESERVATION_TTL_MINUTES=15
